---
import Layout from '../../layouts/Layout.astro';
import db from '../../lib/db.js';
import fs from 'fs';
import path from 'path';

let msg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'create') {
    const name = (formData.get('name') as string)?.trim();
    const price = parseFloat(formData.get('price') as string);
    const description = (formData.get('description') as string)?.trim() || '';
    const categoryId = formData.get('category_id') as string;
    const photo = formData.get('photo') as File;

    if (!name || isNaN(price)) {
      errMsg = 'Nombre y precio son requeridos.';
    } else {
      let imageUrl = '';
      if (photo && photo.size > 0) {
        const uploadsDir = path.join(process.cwd(), 'public', 'uploads');
        fs.mkdirSync(uploadsDir, { recursive: true });
        const fileName = `${Date.now()}-${photo.name.replace(/[^a-zA-Z0-9._-]/g, '_')}`;
        const filePath = path.join(uploadsDir, fileName);
        const buffer = Buffer.from(await photo.arrayBuffer());
        fs.writeFileSync(filePath, buffer);
        imageUrl = `/uploads/${fileName}`;
      }
      db.prepare('INSERT INTO menus (name, price, description, category_id, image_url) VALUES (?, ?, ?, ?, ?)').run(name, price, description, categoryId || null, imageUrl || null);
      return Astro.redirect('/admin?msg=added');
    }
  }

  if (action === 'toggle_featured') {
    const id = formData.get('id') as string;
    const current = db.prepare('SELECT is_featured FROM menus WHERE id = ?').get(id) as any;
    if (current) {
      if (current.is_featured === 0) {
        const count = (db.prepare('SELECT COUNT(*) as c FROM menus WHERE is_featured = 1').get() as any).c;
        if (count >= 3) {
          errMsg = 'Máximo 3 productos destacados. Desmarca uno primero.';
        } else {
          db.prepare('UPDATE menus SET is_featured = 1 WHERE id = ?').run(id);
          return Astro.redirect('/admin?msg=updated');
        }
      } else {
        db.prepare('UPDATE menus SET is_featured = 0 WHERE id = ?').run(id);
        return Astro.redirect('/admin?msg=updated');
      }
    }
  }

  if (action === 'delete') {
    const id = formData.get('id') as string;
    const item = db.prepare('SELECT image_url FROM menus WHERE id = ?').get(id) as any;
    if (item?.image_url) {
      const imgPath = path.join(process.cwd(), 'public', item.image_url);
      if (fs.existsSync(imgPath)) fs.unlinkSync(imgPath);
    }
    db.prepare('DELETE FROM menus WHERE id = ?').run(id);
    return Astro.redirect('/admin?msg=deleted');
  }
}

const urlMsg = Astro.url.searchParams.get('msg');
if (urlMsg === 'added') msg = 'Producto agregado exitosamente.';
if (urlMsg === 'updated') msg = 'Producto actualizado exitosamente.';
if (urlMsg === 'deleted') msg = 'Producto eliminado exitosamente.';

const categories = db.prepare('SELECT * FROM categories ORDER BY name ASC').all() as any[];
const products = db.prepare('SELECT menus.*, categories.name as category_name FROM menus LEFT JOIN categories ON menus.category_id = categories.id ORDER BY menus.created_at DESC').all() as any[];
---

<Layout title="Admin — Pan y Dulce">
  <main class="min-h-screen bg-brand-dark text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-800 text-brand-primary">Panel de Administración</h1>
          <p class="text-gray-500 text-sm mt-1">Gestiona los productos de Pan y Dulce</p>
        </div>
        <div class="flex gap-3">
          <a href="/admin/categorias" class="inline-flex items-center gap-2 bg-white/5 border border-white/10 text-gray-300 font-medium text-sm px-4 py-2 rounded-lg hover:bg-white/10 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            Categorías
          </a>
          <a href="/" class="inline-flex items-center gap-2 bg-white/5 border border-white/10 text-gray-300 font-medium text-sm px-4 py-2 rounded-lg hover:bg-white/10 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Ver Sitio
          </a>
        </div>
      </div>

      <!-- Notifications -->
      {msg && (
        <div class="mb-6 flex items-center justify-between bg-green-500/10 border border-green-500/20 text-green-400 px-4 py-3 rounded-lg">
          <span>{msg}</span>
          <button onclick="this.parentElement.style.display='none'" class="text-green-400 hover:text-green-300 font-bold text-lg leading-none">&times;</button>
        </div>
      )}
      {errMsg && (
        <div class="mb-6 flex items-center justify-between bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-lg">
          <span>{errMsg}</span>
          <button onclick="this.parentElement.style.display='none'" class="text-red-400 hover:text-red-300 font-bold text-lg leading-none">&times;</button>
        </div>
      )}

      <!-- Toggle Add Form -->
      <button id="toggle-form" class="mb-6 inline-flex items-center gap-2 bg-brand-primary text-black font-semibold text-sm px-5 py-2.5 rounded-lg hover:bg-brand-accent transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Agregar Producto
      </button>

      <!-- Create Form (hidden by default) -->
      <div id="create-form" class="hidden mb-8 bg-brand-dark-card border border-white/5 rounded-xl p-6">
        <h2 class="text-xl font-bold mb-4">Nuevo Producto</h2>
        <form method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="hidden" name="action" value="create" />
          <div>
            <label class="block text-sm text-gray-400 mb-1">Nombre *</label>
            <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-brand-primary/50 transition-all" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Precio *</label>
            <input type="number" name="price" step="1" required class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-brand-primary/50 transition-all" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm text-gray-400 mb-1">Descripción</label>
            <textarea name="description" rows="2" class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-brand-primary/50 transition-all resize-none"></textarea>
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Categoría</label>
            <select name="category_id" class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-brand-primary/50 transition-all">
              <option value="">Sin categoría</option>
              {categories.map(cat => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Foto</label>
            <input type="file" name="photo" accept="image/*" class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-brand-primary/10 file:text-brand-primary hover:file:bg-brand-primary/20 transition-all" />
          </div>
          <div class="md:col-span-2">
            <button type="submit" class="bg-brand-primary text-black font-semibold px-6 py-2.5 rounded-lg hover:bg-brand-accent transition-all">Crear Producto</button>
          </div>
        </form>
      </div>

      <!-- Search & Filter -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <input type="text" id="admin-search" placeholder="Buscar por nombre..." class="flex-1 px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-primary/50 transition-all" />
        <select id="admin-cat-filter" class="px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-brand-primary/50 transition-all">
          <option value="">Todas las categorías</option>
          {categories.map(cat => (
            <option value={cat.name}>{cat.name}</option>
          ))}
        </select>
      </div>

      <!-- Products Table -->
      <div class="bg-brand-dark-card border border-white/5 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/5 bg-white/[0.02]">
                <th class="text-left px-4 py-3 text-gray-500 font-medium">Imagen</th>
                <th class="text-left px-4 py-3 text-gray-500 font-medium">Producto</th>
                <th class="text-left px-4 py-3 text-gray-500 font-medium hidden md:table-cell">Categoría</th>
                <th class="text-left px-4 py-3 text-gray-500 font-medium">Precio</th>
                <th class="text-right px-4 py-3 text-gray-500 font-medium">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {products.map(item => (
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors product-row" data-name={item.name.toLowerCase()} data-cat={item.category_name || ''}>
                  <td class="px-4 py-3">
                    {item.image_url ? (
                      <img src={item.image_url} alt={item.name} class="w-12 h-12 object-cover rounded-lg" />
                    ) : (
                      <div class="w-12 h-12 bg-white/5 rounded-lg flex items-center justify-center text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      </div>
                    )}
                  </td>
                  <td class="px-4 py-3">
                    <div class="font-medium text-white">{item.name}</div>
                    {item.description && <div class="text-gray-500 text-xs mt-0.5 line-clamp-1">{item.description}</div>}
                  </td>
                  <td class="px-4 py-3 hidden md:table-cell">
                    {item.category_name ? (
                      <span class="text-xs bg-white/5 px-2 py-1 rounded-full text-gray-400">{item.category_name}</span>
                    ) : (
                      <span class="text-gray-600 text-xs">—</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-brand-primary font-semibold">${item.price.toLocaleString('es-CL')}</td>
                  <td class="px-4 py-3">
                    <div class="flex items-center justify-end gap-1">
                      <form method="POST" class="inline">
                        <input type="hidden" name="action" value="toggle_featured" />
                        <input type="hidden" name="id" value={item.id} />
                        <button type="submit" class={`p-2 rounded-lg transition-all ${item.is_featured ? 'bg-yellow-500/10 text-yellow-400' : 'bg-white/5 text-gray-500 hover:text-yellow-400'}`} title={item.is_featured ? 'Quitar de destacados' : 'Marcar como destacado'}>⭐</button>
                      </form>
                      <a href={`/admin/editar/${item.id}`} class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-blue-400 transition-all" title="Editar">✏️</a>
                      <form method="POST" class="inline" onsubmit="return confirm('¿Eliminar este producto?')">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={item.id} />
                        <button type="submit" class="p-2 rounded-lg bg-white/5 text-gray-500 hover:text-red-400 transition-all" title="Eliminar">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {products.length === 0 && (
            <div class="text-center py-12 text-gray-500">
              <p>No hay productos aún. ¡Crea el primero!</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.getElementById('toggle-form')?.addEventListener('click', () => {
    const form = document.getElementById('create-form')!;
    form.classList.toggle('hidden');
  });

  const searchInput = document.getElementById('admin-search') as HTMLInputElement;
  const catFilter = document.getElementById('admin-cat-filter') as HTMLSelectElement;
  const rows = document.querySelectorAll('.product-row') as NodeListOf<HTMLElement>;

  function filterRows() {
    const q = searchInput?.value.toLowerCase() || '';
    const cat = catFilter?.value || '';
    rows.forEach(row => {
      const name = row.dataset.name || '';
      const rowCat = row.dataset.cat || '';
      const show = name.includes(q) && (cat === '' || rowCat === cat);
      row.style.display = show ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterRows);
  catFilter?.addEventListener('change', filterRows);
</script>
