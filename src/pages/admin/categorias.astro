---
import Layout from '../../layouts/Layout.astro';
import db from '../../lib/db.js';

let msg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'create') {
    const name = (formData.get('name') as string)?.trim();
    if (!name) {
      errMsg = 'El nombre es requerido.';
    } else {
      db.prepare('INSERT INTO categories (name) VALUES (?)').run(name);
      msg = 'Categoría creada exitosamente.';
    }
  }

  if (action === 'edit') {
    const id = formData.get('id') as string;
    const name = (formData.get('name') as string)?.trim();
    if (name) {
      db.prepare('UPDATE categories SET name = ? WHERE id = ?').run(name, id);
      msg = 'Categoría actualizada.';
    }
  }

  if (action === 'delete') {
    const id = formData.get('id') as string;
    db.prepare('UPDATE menus SET category_id = NULL WHERE category_id = ?').run(id);
    db.prepare('DELETE FROM categories WHERE id = ?').run(id);
    msg = 'Categoría eliminada.';
  }
}

const categories = db.prepare('SELECT * FROM categories ORDER BY name ASC').all() as any[];
---

<Layout title="Categorías — Admin Pan y Dulce">
  <main class="min-h-screen bg-brand-dark text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-800 text-brand-primary">Gestionar Categorías</h1>
          <p class="text-gray-500 text-sm mt-1">Crea y administra las categorías de tus productos</p>
        </div>
        <a href="/admin" class="inline-flex items-center gap-2 bg-white/5 border border-white/10 text-gray-300 font-medium text-sm px-4 py-2 rounded-lg hover:bg-white/10 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver
        </a>
      </div>

      <!-- Notifications -->
      {msg && (
        <div class="mb-6 flex items-center justify-between bg-green-500/10 border border-green-500/20 text-green-400 px-4 py-3 rounded-lg">
          <span>{msg}</span>
          <button onclick="this.parentElement.style.display='none'" class="text-green-400 hover:text-green-300 font-bold text-lg leading-none">&times;</button>
        </div>
      )}
      {errMsg && (
        <div class="mb-6 flex items-center justify-between bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-lg">
          <span>{errMsg}</span>
          <button onclick="this.parentElement.style.display='none'" class="text-red-400 hover:text-red-300 font-bold text-lg leading-none">&times;</button>
        </div>
      )}

      <!-- Create Form -->
      <div class="mb-8 bg-brand-dark-card border border-white/5 rounded-xl p-6">
        <h2 class="text-lg font-bold mb-4">Nueva Categoría</h2>
        <form method="POST" class="flex gap-3">
          <input type="hidden" name="action" value="create" />
          <input type="text" name="name" required placeholder="Nombre de la categoría" class="flex-1 px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-primary/50 transition-all" />
          <button type="submit" class="bg-brand-primary text-black font-semibold px-6 py-2.5 rounded-lg hover:bg-brand-accent transition-all shrink-0">Crear</button>
        </form>
      </div>

      <!-- Categories Table -->
      <div class="bg-brand-dark-card border border-white/5 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5 bg-white/[0.02]">
              <th class="text-left px-4 py-3 text-gray-500 font-medium">Nombre</th>
              <th class="text-right px-4 py-3 text-gray-500 font-medium">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {categories.map(cat => (
              <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                <td class="px-4 py-3 text-white font-medium">{cat.name}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2">
                    <button
                      onclick={`
                        const newName = prompt('Nuevo nombre para "${cat.name}":', '${cat.name}');
                        if (newName && newName.trim()) {
                          const f = document.createElement('form');
                          f.method = 'POST';
                          f.innerHTML = '<input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="${cat.id}"><input type="hidden" name="name" value="' + newName.trim() + '">';
                          document.body.appendChild(f);
                          f.submit();
                        }
                      `}
                      class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-blue-400 transition-all" title="Editar">✏️</button>
                    <form method="POST" class="inline" onsubmit="return confirm('¿Eliminar esta categoría? Los productos de esta categoría quedarán sin categoría.')">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={cat.id} />
                      <button type="submit" class="p-2 rounded-lg bg-white/5 text-gray-500 hover:text-red-400 transition-all" title="Eliminar">🗑️</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {categories.length === 0 && (
          <div class="text-center py-12 text-gray-500">
            <p>No hay categorías aún.</p>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>
