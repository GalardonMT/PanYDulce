---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

function href(hash: string) {
  return isHome ? hash : `/${hash}`;
}

const navLinks = [
  { label: 'Inicio', target: '#inicio' },
  { label: 'Nosotros', target: '#nosotros' },
  { label: 'Menú', target: '#menu' },
  { label: 'Contacto', target: '#contacto' },
];
---

<header class="fixed top-0 w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/5">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-2xl font-800 text-brand-primary tracking-tight group-hover:text-brand-accent transition-colors duration-300">Pan y Dulce</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={href(link.target)}
          class="text-sm font-medium text-gray-300 hover:text-brand-primary transition-colors duration-300 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-primary after:transition-all after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/menu"
        class="text-sm font-medium text-gray-300 hover:text-brand-primary transition-colors duration-300 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-primary after:transition-all after:duration-300 hover:after:w-full"
      >
        Ver Menú
      </a>
      <a
        href="https://wa.me/56912341234"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-brand-primary text-black font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-brand-accent hover:shadow-lg hover:shadow-brand-primary/25 hover:-translate-y-0.5 transition-all duration-300"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-white/5 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <span class="block w-6 h-0.5 bg-white transition-all duration-300" id="ham-top"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300" id="ham-mid"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300" id="ham-bot"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-1 px-4 pb-4 bg-black/95 backdrop-blur-lg border-b border-white/5"
  >
    {navLinks.map(link => (
      <a
        href={href(link.target)}
        class="mobile-nav-link block py-3 px-4 text-gray-300 hover:text-brand-primary hover:bg-white/5 rounded-lg transition-all duration-300 text-sm font-medium"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/menu"
      class="mobile-nav-link block py-3 px-4 text-gray-300 hover:text-brand-primary hover:bg-white/5 rounded-lg transition-all duration-300 text-sm font-medium"
    >
      Ver Menú
    </a>
    <a
      href="https://wa.me/56912341234"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-link mt-2 flex items-center justify-center gap-2 bg-brand-primary text-black font-semibold text-sm px-5 py-3 rounded-full hover:bg-brand-accent transition-all duration-300"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      WhatsApp
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamTop = document.getElementById('ham-top');
  const hamMid = document.getElementById('ham-mid');
  const hamBot = document.getElementById('ham-bot');
  let isOpen = false;

  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    menu?.classList.toggle('hidden', !isOpen);
    menu?.classList.toggle('flex', isOpen);

    if (isOpen) {
      hamTop!.style.transform = 'rotate(45deg) translate(4px, 4px)';
      hamMid!.style.opacity = '0';
      hamBot!.style.transform = 'rotate(-45deg) translate(4px, -4px)';
    } else {
      hamTop!.style.transform = '';
      hamMid!.style.opacity = '1';
      hamBot!.style.transform = '';
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      isOpen = false;
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      hamTop!.style.transform = '';
      hamMid!.style.opacity = '1';
      hamBot!.style.transform = '';
    });
  });
</script>
