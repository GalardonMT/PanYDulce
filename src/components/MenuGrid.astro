---
import db from '../lib/db.js';
const featured = db.prepare('SELECT * FROM menus WHERE is_featured = 1 LIMIT 3').all();
---

<section id="menu" class="py-20 md:py-28 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-block text-brand-primary text-sm font-semibold tracking-widest uppercase mb-3">Nuestros Productos</span>
      <h2 class="text-3xl sm:text-4xl font-800 text-white mb-4">Productos Destacados</h2>
      <p class="text-gray-500 max-w-xl mx-auto">Una selección de nuestras mejores creaciones artesanales.</p>
    </div>

    {featured.length === 0 ? (
      <div class="text-center py-16">
        <div class="text-6xl mb-4">🍞</div>
        <p class="text-gray-500 text-lg">Pronto agregaremos nuestros productos destacados.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured.map((item: any) => (
          <div class="group bg-brand-dark-card rounded-2xl overflow-hidden border border-white/5 hover:border-brand-primary/30 hover:-translate-y-2 transition-all duration-500 shadow-lg hover:shadow-2xl hover:shadow-brand-primary/10">
            <div class="relative overflow-hidden h-56">
              {item.image_url ? (
                <img src={item.image_url} alt={item.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-brand-dark-lighter flex items-center justify-center">
                  <svg class="w-16 h-16 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
              )}
              <div class="absolute top-4 right-4 bg-brand-primary text-black text-sm font-bold px-3 py-1 rounded-full shadow-lg">
                ${item.price.toLocaleString('es-CL')}
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-white mb-2 group-hover:text-brand-primary transition-colors">{item.name}</h3>
              {item.description && <p class="text-gray-500 text-sm line-clamp-2">{item.description}</p>}
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="text-center mt-12">
      <a href="/menu" class="inline-flex items-center gap-2 bg-white/5 border border-white/10 text-white font-semibold px-8 py-4 rounded-full hover:bg-brand-primary hover:text-black hover:border-brand-primary hover:-translate-y-1 transition-all duration-300">
        Ver Menú Completo
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>
